#ifndef SECRETS_H
#define SECRETS_H

// ============================================================
//  SECRETS TEMPLATE — Copy this file to secrets.h and fill in
//  your actual credentials. secrets.h is gitignored by default.
// ============================================================

// WiFi credentials
const char* WIFI_SSID     = "your-ssid";
const char* WIFI_PASSWORD = "your-password";

// Edge gateway endpoint
const char* EDGE_GATEWAY_URL = "http://192.168.1.100:5000/api/v1/telemetry";

// API key shared between device and edge gateway
const char* API_KEY = "your-secret-api-key";

// Device identifier (must match edge gateway registration)
const char* DEVICE_ID = "aquaedge-01";

// Compile-time switch: set to 0 to disable WiFi/HTTP and use Serial-only telemetry.
// Useful for testing hardware without a network, or on public WiFi where LAN
// device-to-device traffic is blocked (e.g., college, café, airport).
// When 0: no WiFi connection attempted, no HTTPClient linked, smaller binary.
// When 1: full HTTP telemetry to EDGE_GATEWAY_URL as documented.
#define ENABLE_HTTP_TELEMETRY 1

#endif // SECRETS_H
